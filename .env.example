# ===== MySQL 持久化配置 =====
# 填好后复制为 .env 并重启服务：
#   cp .env.example .env
# 或直接设置系统环境变量。DB_HOST 等留空则继续使用本地 db.json。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=zhiyun_label

# ===== 服务配置（可选）=====
# API_PORT=3001
# JWT_SECRET=change-me

# 数据治理模块演示数据（该模块界面已隐藏）：默认不注入，设为 1 可注入演示数据集
SEED_GOVERNANCE_DEMO=

# 限流：0 可整体关闭；auth 为登录类接口，api 为其余业务接口（次/分钟）
RATE_LIMIT_ENABLED=1
RATE_LIMIT_AUTH_PER_MIN=120
RATE_LIMIT_API_PER_MIN=3000
