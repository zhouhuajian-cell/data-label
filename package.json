    "mysql2": "^3.23.3",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "ssh2": "^1.17.0",
    "vite": "^5.0.0"
  }
