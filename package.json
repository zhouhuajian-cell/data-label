{
  "name": "data-label",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.js",
    "test": "node --test",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "serve:prod": "node server/index.js",
    "docker:build": "docker build -t data-label .",
    "docker:run": "docker run --rm -p 3001:3001 -e NODE_ENV=production -e JWT_SECRET=change-me data-label",
