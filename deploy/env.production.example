# ===== 服务器生产环境配置（部署脚本会生成到 /opt/data_label/.env，权限 600）=====
# 手工部署时复制为 .env：
#   cp deploy/env.production.example /opt/data_label/.env && chmod 600 /opt/data_label/.env

# 运行环境（生产强制要求 MySQL，缺 DB_* 会拒绝启动）
NODE_ENV=production

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=data_label
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=data_label

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=3001

# 必填：登录令牌签名密钥，泄露等于任何人可伪造登录
# 生成：openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
# 登录态有效期（秒），默认 8 小时
TOKEN_TTL_SECONDS=28800

# 允许访问的前端来源，部署后改成真实访问地址（不要用 *）
CORS_ORIGIN=http://10.2.248.6,http://10.2.248.6:3001

# 单次请求体上限（上传 Excel/附件用），默认 50MB
MAX_BODY_BYTES=52428800

# ===== 限流（1=启用，0=关闭）=====
RATE_LIMIT_ENABLED=1
RATE_LIMIT_AUTH_PER_MIN=120
RATE_LIMIT_API_PER_MIN=3000
