# PostgreSQL 连接串（数据库名 gnd_production，PRD 4）
DATABASE_URL=postgresql+asyncpg://gnd:gnd@localhost:5432/gnd_production
# Redis（防重复提交锁）
REDIS_URL=redis://localhost:6379/0
# JWT
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# 里程差异阈值（百分比）
MILEAGE_DIFFERENCE_THRESHOLD=5.0
# CORS 允许来源（逗号分隔；前端 vite 端口 3000 + 5173）
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
